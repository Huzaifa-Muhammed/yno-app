app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Node dependencies. `server/.gitignore` covers its own; these are the other
# two npm roots in the tree (the Firestore rules test harness and the join
# site), which were staging ~9,600 files on the first `git add -A`.
**/node_modules/

# Local Firebase emulator output.
firestore-debug.log
firebase-debug.log
# Firebase Hosting deploy cache — hashes of the last uploaded build.
.firebase/
ui-debug.log

# Android Gradle build output (the root /build/ rule doesn't cover this one).
/android/build/
/android/.gradle/

# Stale config backup from the org.nellab.yno migration — it holds the DELETED
# Firebase app's ids and would only mislead.
android/app/google-services.json.bak-pre-sha
